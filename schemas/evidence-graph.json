{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://answer.local/schemas/evidence-graph.json",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "question_signal",
              "source_evidence",
              "candidate_claim",
              "relation",
              "method_action",
              "decision",
              "verification",
              "action_artifact",
              "image_evidence"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "span": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "field",
              "start",
              "end",
              "quote"
            ],
            "additionalProperties": false
          },
          "method_id": {
            "type": "string",
            "minLength": 1
          },
          "candidate": {
            "type": "string",
            "minLength": 1
          },
          "reviewed": {
            "type": "boolean"
          },
          "execution_id": {
            "type": "string",
            "minLength": 1
          },
          "artifact_kind": {
            "enum": [
              "candidate_decision",
              "candidate_partition",
              "framework_card",
              "interpretation",
              "located_evidence",
              "route_selection",
              "text_groups",
              "verification_result"
            ]
          },
          "artifact_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "image_ref": {
            "type": "object",
            "properties": {
              "image_id": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "box": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "required": [
              "image_id",
              "sha256",
              "box"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "type",
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "supports",
              "contradicts",
              "locates",
              "expands",
              "narrows",
              "eliminates",
              "verifies"
            ]
          }
        },
        "required": [
          "from",
          "to",
          "type"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "nodes",
    "edges"
  ],
  "additionalProperties": false
}

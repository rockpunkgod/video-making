{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://answer.local/schemas/pedagogy-plan.json",
  "title": "Frozen selective-disclosure PedagogyPlan; deterministic projection, not truth certification",
  "type": "object",
  "additionalProperties": false,
  "allOf": [{"required": ["question_id", "original_question", "method_stamp"]}],
  "required": ["schema_version", "kind", "compiler_version", "policy_version", "plan_id", "plan_sha", "source_analysis_sha", "input_binding", "method_id", "method_version", "role", "mode", "audience", "channel", "duration_target", "duration_status", "symptom", "first_signal", "first_action", "judgment_point", "memory_phrase", "student_steps", "student_model", "evidence_refs", "boundaries", "omitted_items", "followup_content", "case_content_matrix", "teaching_risk", "compression_audit", "cognitive_load", "answer_scope", "stop_state", "working_rule", "payoff", "prohibited_claims", "public_claims", "source_refs", "truth_guard", "semantic_review", "availability", "release_state", "public_render_ready", "replay_request", "generated_at", "content_sha", "envelope_sha"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "kind": {"const": "pedagogy_plan"},
    "compiler_version": {"const": "0.1.0"},
    "policy_version": {"const": "0.1.0"},
    "plan_id": {"type": "string", "pattern": "^pedagogy:[a-f0-9]{64}$"},
    "plan_sha": {"$ref": "#/$defs/sha"},
    "source_analysis_sha": {"$ref": "#/$defs/sha"},
    "input_binding": {"$ref": "#/$defs/input_binding"},
    "method_id": {"type": "string", "minLength": 1},
    "question_id": {"type": "string", "minLength": 1},
    "original_question": {"type": "object", "additionalProperties": false, "required": ["question_id", "stem"], "properties": {"question_id": {"type": "string"}, "stem": {"type": "string"}, "options": {"type": "object", "additionalProperties": {"type": "string"}}}},
    "method_version": {"type": "string", "minLength": 1},
    "role": {"enum": ["locator", "interpreter", "reducer", "framework", "decider", "verifier"]},
    "mode": {"enum": ["first_touch", "worked_example", "counterexample", "boundary", "transfer", "hard_case", "review"]},
    "audience": {"enum": ["first_time_student", "returning_student"]},
    "channel": {"enum": ["video", "lesson", "card", "wechat"]},
    "duration_target": {"type": "number", "exclusiveMinimum": 0},
    "duration_status": {"const": "editorial_target_not_timing_or_learning_efficacy_certification"},
    "method_stamp": {"$ref": "#/$defs/nullable_item"},
    "symptom": {"$ref": "#/$defs/nullable_item"},
    "first_signal": {"$ref": "#/$defs/nullable_item"},
    "first_action": {"$ref": "#/$defs/nullable_item"},
    "judgment_point": {"$ref": "#/$defs/nullable_item"},
    "memory_phrase": {"$ref": "#/$defs/nullable_item"},
    "student_steps": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "item"], "properties": {"kind": {"enum": ["question", "observation", "action", "evidence", "judgment", "stop", "case"]}, "item": {"anyOf": [{"$ref": "#/$defs/item"}, {"$ref": "#/$defs/boundary"}]}}}},
    "student_model": {"type": "object", "additionalProperties": false, "required": ["see", "think", "do", "check", "stop"], "properties": {"see": {"$ref": "#/$defs/nullable_item"}, "think": {"$ref": "#/$defs/nullable_item"}, "do": {"$ref": "#/$defs/nullable_item"}, "check": {"$ref": "#/$defs/nullable_item"}, "stop": {"anyOf": [{"$ref": "#/$defs/boundary"}, {"type": "null"}]}}},
    "evidence_refs": {"$ref": "#/$defs/refs"},
    "boundaries": {"type": "object", "additionalProperties": false, "required": ["tell_now", "tell_later", "engine_only"], "properties": {
      "tell_now": {"type": "array", "items": {"$ref": "#/$defs/boundary"}},
      "tell_later": {"type": "array", "items": {"$ref": "#/$defs/boundary"}},
      "engine_only": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["item_id", "field", "disclosure_tier", "reason"], "properties": {"item_id": {"type": "string"}, "field": {"enum": ["method_id", "method_version", "role", "review_refs", "evidence_refs", "source_analysis_sha", "release_state"]}, "disclosure_tier": {"const": "ENGINE_ONLY"}, "reason": {"type": "string"}}}}
    }},
    "omitted_items": {"type": "array", "items": {"$ref": "#/$defs/omission"}},
    "followup_content": {"type": "object", "additionalProperties": false, "required": ["counterexample", "boundary", "transfer", "hard"], "properties": {"counterexample": {"$ref": "#/$defs/followup"}, "boundary": {"$ref": "#/$defs/followup"}, "transfer": {"$ref": "#/$defs/followup"}, "hard": {"$ref": "#/$defs/followup"}}},
    "case_content_matrix": {"type": "object", "additionalProperties": false, "required": ["canonical", "counterexample", "boundary", "transfer", "hard"], "properties": {"canonical": {"const": ["first_touch", "worked_example"]}, "counterexample": {"const": ["counterexample"]}, "boundary": {"const": ["boundary"]}, "transfer": {"const": ["transfer"]}, "hard": {"const": ["hard_case"]}}},
    "teaching_risk": {"type": "object", "additionalProperties": false, "required": ["levels", "items", "unknown_is_low", "numeric_score"], "properties": {"levels": {"const": ["low", "medium", "high", "unknown"]}, "unknown_is_low": {"const": false}, "numeric_score": {"type": "null"}, "items": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["item_id", "risk", "tier", "assessment_refs", "reason"], "properties": {"item_id": {"type": "string"}, "risk": {"$ref": "#/$defs/risk"}, "tier": {"enum": ["TELL_NOW", "TELL_LATER", "ENGINE_ONLY"]}, "assessment_refs": {"$ref": "#/$defs/refs"}, "reason": {"type": "string"}}}}}},
    "compression_audit": {"type": "object", "additionalProperties": false, "required": ["included", "omitted", "preserved", "prohibited_changes", "guard_sha", "structural_lint_only", "semantic_truth_certification"], "properties": {"included": {"$ref": "#/$defs/strings"}, "omitted": {"type": "array", "items": {"$ref": "#/$defs/omission"}}, "preserved": {"const": ["evidence", "role", "stop", "certainty", "answer", "maturity"]}, "prohibited_changes": {"$ref": "#/$defs/strings"}, "guard_sha": {"$ref": "#/$defs/sha"}, "structural_lint_only": {"const": true}, "semantic_truth_certification": {"const": false}}},
    "cognitive_load": {"type": "object", "additionalProperties": false, "required": ["budget", "metrics", "status", "exceeded"], "properties": {"budget": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}, "metrics": {"type": "object", "additionalProperties": false, "required": ["core_actions", "primary_boundary", "memory_phrase", "primary_evidence_cluster", "simultaneous_concepts"], "properties": {"core_actions": {"type": "integer", "minimum": 0}, "primary_boundary": {"type": "integer", "minimum": 0}, "memory_phrase": {"type": "integer", "minimum": 0}, "primary_evidence_cluster": {"type": "integer", "minimum": 0}, "simultaneous_concepts": {"type": "integer", "minimum": 0}}}, "status": {"enum": ["PASS", "PEDAGOGY_OVERLOAD", "NOT_FIRST_TOUCH"]}, "exceeded": {"$ref": "#/$defs/strings"}}},
    "answer_scope": {"type": "object", "additionalProperties": false, "required": ["scope", "answer", "may_output_final_answer", "upstream_answer", "upstream_closed", "actual_outputs"], "properties": {"scope": {"const": "method_action_demo"}, "answer": {"type": "null"}, "may_output_final_answer": {"const": false}, "upstream_answer": {}, "upstream_closed": {"type": "boolean"}, "actual_outputs": {"type": "array", "minItems": 1}}},
    "stop_state": {"type": "object", "additionalProperties": false, "required": ["state", "stop_applied", "method_stop_ref", "action_stop_refs"], "properties": {"state": {"const": "produced_bounded_action"}, "stop_applied": {"const": false}, "method_stop_ref": {"$ref": "#/$defs/ref"}, "action_stop_refs": {"$ref": "#/$defs/refs"}}},
    "working_rule": {"type": "object", "additionalProperties": false, "required": ["text", "method_id", "version", "role", "scope", "certainty", "source_action_refs", "source_text_refs"], "properties": {"text": {"type": ["string", "null"]}, "method_id": {"type": "string"}, "version": {"type": "string"}, "role": {"type": "string"}, "scope": {"const": "selected_question_and_actual_action"}, "certainty": {"const": "upstream_reviewed_assertion_not_independent_semantic_certification"}, "source_action_refs": {"$ref": "#/$defs/refs"}, "source_text_refs": {"$ref": "#/$defs/refs"}}},
    "payoff": {"type": "object", "additionalProperties": false, "required": ["before_complexity", "after_structure", "allowed_claim", "visualizable", "performance_claim_allowed", "reviewed_support"], "properties": {"before_complexity": {"$ref": "#/$defs/strings"}, "after_structure": {"type": "array"}, "allowed_claim": {"$ref": "#/$defs/nullable_item"}, "visualizable": {"type": "boolean"}, "performance_claim_allowed": {"const": false}, "reviewed_support": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["record", "source_refs", "action_artifact_refs", "evidence_refs", "review_refs"], "properties": {"record": {"type": "object"}, "source_refs": {"$ref": "#/$defs/refs"}, "action_artifact_refs": {"$ref": "#/$defs/refs"}, "evidence_refs": {"$ref": "#/$defs/refs"}, "review_refs": {"$ref": "#/$defs/refs"}}}]}}},
    "prohibited_claims": {"$ref": "#/$defs/strings"},
    "public_claims": {"type": "array", "items": {"anyOf": [{"$ref": "#/$defs/item"}, {"$ref": "#/$defs/boundary"}]}},
    "source_refs": {"$ref": "#/$defs/refs"},
    "truth_guard": {"type": "object", "additionalProperties": false, "required": ["method_ref", "action_refs", "evidence_refs", "review_refs", "method_stop_ref", "action_stop_refs", "upstream_answer", "upstream_closed", "method_maturity", "method_utility"], "properties": {"method_ref": {"$ref": "#/$defs/ref"}, "action_refs": {"$ref": "#/$defs/refs"}, "evidence_refs": {"$ref": "#/$defs/refs"}, "review_refs": {"$ref": "#/$defs/refs"}, "method_stop_ref": {"$ref": "#/$defs/ref"}, "action_stop_refs": {"$ref": "#/$defs/refs"}, "upstream_answer": {}, "upstream_closed": {"type": "boolean"}, "method_maturity": {"type": "string"}, "method_utility": {"type": "string"}}},
    "semantic_review": {"type": "object", "additionalProperties": false, "required": ["level", "independent_human_certified"], "properties": {"level": {"enum": ["unreviewed", "ai_reviewed", "human_reviewed", "human_certified"]}, "independent_human_certified": {"type": "boolean"}}},
    "availability": {"type": "object", "additionalProperties": false, "required": ["status", "gaps", "blockers"], "properties": {"status": {"enum": ["READY", "HOLD", "UNAVAILABLE_EVIDENCE_GAP"]}, "gaps": {"$ref": "#/$defs/strings"}, "blockers": {"$ref": "#/$defs/strings"}}},
    "release_state": {"const": {"teaching": "HOLD", "source_display": "HOLD", "editorial": "HOLD"}},
    "public_render_ready": {"const": false},
    "replay_request": {"type": "object", "additionalProperties": false, "required": ["selection", "fields", "extra_boundary_refs"], "properties": {"selection": {"type": "object", "additionalProperties": false, "required": ["method_id", "action_ids"], "properties": {"method_id": {"type": "string"}, "action_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}}, "fields": {"type": "object", "additionalProperties": false, "properties": {"symptom": {"type": "string"}, "first_signal": {"type": "string"}, "first_action": {"type": "string"}, "judgment_point": {"type": "string"}, "memory_phrase": {"type": "string"}}}, "extra_boundary_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "generated_at": {"type": "string", "minLength": 1},
    "content_sha": {"$ref": "#/$defs/sha"},
    "envelope_sha": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "strings": {"type": "array", "items": {"type": "string"}},
    "ref": {"type": "object", "additionalProperties": false, "required": ["asset_id", "pointer", "sha"], "properties": {"asset_id": {"type": "string", "minLength": 1}, "pointer": {"type": "string", "pattern": "^/"}, "sha": {"$ref": "#/$defs/sha"}}},
    "refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "item": {"type": "object", "additionalProperties": false, "required": ["item_id", "text", "projection_operation", "source_refs", "action_artifact_refs", "evidence_refs", "review_refs"], "properties": {"item_id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "projection_operation": {"enum": ["implementation_labels_only_v1", "literal_source_v1"]}, "source_refs": {"$ref": "#/$defs/refs"}, "action_artifact_refs": {"$ref": "#/$defs/refs"}, "evidence_refs": {"$ref": "#/$defs/refs"}, "review_refs": {"$ref": "#/$defs/refs"}}},
    "nullable_item": {"anyOf": [{"$ref": "#/$defs/item"}, {"type": "null"}]},
    "risk": {"type": "object", "additionalProperties": false, "required": ["frequency", "severity", "current_relevance"], "properties": {"frequency": {"enum": ["low", "medium", "high", "unknown"]}, "severity": {"enum": ["low", "medium", "high", "unknown"]}, "current_relevance": {"enum": ["low", "medium", "high", "unknown"]}}},
    "boundary": {"type": "object", "additionalProperties": false, "required": ["item_id", "text", "projection_operation", "source_refs", "action_artifact_refs", "evidence_refs", "review_refs", "disclosure_tier", "risk", "risk_assessment_refs", "disclosure_reason", "current_action_stop"], "properties": {"item_id": {"type": "string"}, "text": {"type": "string", "minLength": 1}, "projection_operation": {"const": "implementation_labels_only_v1"}, "source_refs": {"$ref": "#/$defs/refs"}, "action_artifact_refs": {"$ref": "#/$defs/refs"}, "evidence_refs": {"$ref": "#/$defs/refs"}, "review_refs": {"$ref": "#/$defs/refs"}, "disclosure_tier": {"enum": ["TELL_NOW", "TELL_LATER"]}, "risk": {"$ref": "#/$defs/risk"}, "risk_assessment_refs": {"$ref": "#/$defs/refs"}, "disclosure_reason": {"type": "string"}, "current_action_stop": {"type": "boolean"}}},
    "omission": {"type": "object", "additionalProperties": false, "required": ["item_id", "reason", "disclosure_tier", "still_exists", "source_refs"], "properties": {"item_id": {"type": "string"}, "reason": {"type": "string"}, "disclosure_tier": {"enum": ["TELL_LATER", "ENGINE_ONLY", "BACKEND_GUARD"]}, "still_exists": {"const": true}, "source_refs": {"$ref": "#/$defs/refs"}, "risk_assessment_refs": {"$ref": "#/$defs/refs"}}},
    "followup": {"type": "object", "additionalProperties": false, "required": ["status", "case_ref"], "properties": {"status": {"enum": ["AVAILABLE", "UNAVAILABLE_EVIDENCE_GAP"]}, "case_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}}},
    "input_binding": {"type": "object", "additionalProperties": false, "required": ["asset_id", "semantic_binding_sha", "source_sha", "question_sha", "selected_method_sha", "selected_actions_sha", "transport"], "properties": {"asset_id": {"type": "string"}, "semantic_binding_sha": {"$ref": "#/$defs/sha"}, "source_sha": {"$ref": "#/$defs/sha"}, "question_sha": {"$ref": "#/$defs/sha"}, "selected_method_sha": {"$ref": "#/$defs/sha"}, "selected_actions_sha": {"$ref": "#/$defs/sha"}, "transport": {"enum": ["frozen_asset", "reviewed_passage"]}}}
  }
}

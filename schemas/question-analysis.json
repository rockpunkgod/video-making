{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://answer.local/schemas/question-analysis.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "question_type": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "method_matches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "locator",
              "interpreter",
              "reducer",
              "decider",
              "verifier",
              "framework"
            ]
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "trigger_verified": {
            "type": "boolean"
          }
        },
        "required": [
          "method_id",
          "role",
          "confidence",
          "reason",
          "trigger_verified"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "method_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "locator",
              "interpreter",
              "reducer",
              "decider",
              "verifier",
              "framework"
            ]
          },
          "input": {
            "type": "string",
            "minLength": 1
          },
          "output": {
            "enum": [
              "locate",
              "interpret",
              "reduce",
              "decide",
              "verify"
            ]
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "stop_rule": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "planned",
              "reviewed"
            ]
          }
        },
        "required": [
          "method_id",
          "role",
          "input",
          "output",
          "action",
          "stop_rule",
          "state"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "trigger_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "field",
          "start",
          "end",
          "quote"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "evidence_graph": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "question_signal",
                  "source_evidence",
                  "candidate_claim",
                  "relation",
                  "method_action",
                  "decision",
                  "verification"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "span": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "field",
                  "start",
                  "end",
                  "quote"
                ],
                "additionalProperties": false
              },
              "method_id": {
                "type": "string",
                "minLength": 1
              },
              "candidate": {
                "type": "string",
                "minLength": 1
              },
              "reviewed": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "type",
              "label"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "supports",
                  "contradicts",
                  "locates",
                  "expands",
                  "narrows",
                  "eliminates",
                  "verifies"
                ]
              }
            },
            "required": [
              "from",
              "to",
              "type"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    },
    "candidate_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "enum": [
              "retain",
              "eliminate",
              "undetermined"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "method_id": {
            "type": "string",
            "minLength": 1
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "candidate",
          "effect",
          "claim",
          "method_id",
          "reviewer",
          "evidence_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "answer": {
      "type": [
        "string",
        "null"
      ]
    },
    "answer_confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "student_symptoms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "demonstration": {
      "type": "object",
      "properties": {
        "method_clarity": {
          "type": "number",
          "minimum": 0
        },
        "contrast": {
          "type": "number",
          "minimum": 0
        },
        "visuality": {
          "type": "number",
          "minimum": 0
        },
        "transferability": {
          "type": "number",
          "minimum": 0
        },
        "trigger_clarity": {
          "type": "number",
          "minimum": 0
        },
        "evidence_visibility": {
          "type": "number",
          "minimum": 0
        },
        "compression": {
          "type": "number",
          "minimum": 0
        },
        "score": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "method_clarity",
        "contrast",
        "visuality",
        "transferability",
        "trigger_clarity",
        "evidence_visibility",
        "compression",
        "score"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "needs_evidence",
        "reviewed",
        "unsupported_type",
        "incomplete_input"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "stop_rule": {
      "type": "string",
      "minLength": 1
    },
    "review_scope": {
      "type": "string",
      "minLength": 1
    },
    "method_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "content_eligible": {
      "type": "boolean"
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard",
        "unknown"
      ]
    },
    "answer_verification": {
      "type": "object",
      "properties": {
        "retained_candidates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "eliminated_candidates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "unresolved_candidates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "candidate_coverage_complete": {
          "type": "boolean"
        },
        "unique_supported_candidate": {
          "type": "boolean"
        },
        "closed": {
          "type": "boolean"
        }
      },
      "required": [
        "retained_candidates",
        "eliminated_candidates",
        "unresolved_candidates",
        "candidate_coverage_complete",
        "unique_supported_candidate",
        "closed"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "question_id",
    "question_type",
    "task_type",
    "method_matches",
    "method_chain",
    "trigger_evidence",
    "evidence_graph",
    "candidate_analysis",
    "answer",
    "answer_confidence",
    "student_symptoms",
    "demonstration",
    "status",
    "limitations",
    "next_action",
    "stop_rule",
    "review_scope",
    "method_versions",
    "content_eligible",
    "difficulty",
    "answer_verification"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://answer.local/schemas/question-analysis.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "question_type": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "method_matches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "locator",
              "interpreter",
              "reducer",
              "decider",
              "verifier",
              "framework"
            ]
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "trigger_verified": {
            "type": "boolean"
          }
        },
        "required": [
          "method_id",
          "role",
          "confidence",
          "reason",
          "trigger_verified"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "method_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "locator",
              "interpreter",
              "reducer",
              "decider",
              "verifier",
              "framework"
            ]
          },
          "input": {
            "type": "string",
            "minLength": 1
          },
          "output": {
            "enum": [
              "locate",
              "interpret",
              "reduce",
              "decide",
              "verify"
            ]
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "stop_rule": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "planned",
              "reviewed"
            ]
          }
        },
        "required": [
          "method_id",
          "role",
          "input",
          "output",
          "action",
          "stop_rule",
          "state"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "trigger_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "field",
          "start",
          "end",
          "quote"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "evidence_graph": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "question_signal",
                  "source_evidence",
                  "candidate_claim",
                  "relation",
                  "method_action",
                  "decision",
                  "verification"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "span": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1
                  },
                  "start": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "field",
                  "start",
                  "end",
                  "quote"
                ],
                "additionalProperties": false
              },
              "method_id": {
                "type": "string",
                "minLength": 1
              },
              "candidate": {
                "type": "string",
                "minLength": 1
              },
              "reviewed": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "type",
              "label"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "supports",
                  "contradicts",
                  "locates",
                  "expands",
                  "narrows",
                  "eliminates",
                  "verifies"
                ]
              }
            },
            "required": [
              "from",
              "to",
              "type"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    },
    "candidate_analysis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "enum": [
              "retain",
              "eliminate",
              "undetermined"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "method_id": {
            "type": "string",
            "minLength": 1
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "candidate",
          "effect",
          "claim",
          "method_id",
          "reviewer",
          "evidence_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "answer": {
      "type": [
        "string",
        "null"
      ]
    },
    "answer_confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "student_symptoms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "demonstration": {
      "type": "object",
      "properties": {
        "method_clarity": {
          "type": "number",
          "minimum": 0
        },
        "contrast": {
          "type": "number",
          "minimum": 0
        },
        "visuality": {
          "type": "number",
          "minimum": 0
        },
        "transferability": {
          "type": "number",
          "minimum": 0
        },
        "trigger_clarity": {
          "type": "number",
          "minimum": 0
        },
        "evidence_visibility": {
          "type": "number",
          "minimum": 0
        },
        "compression": {
          "type": "number",
          "minimum": 0
        },
        "score": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "method_clarity",
        "contrast",
        "visuality",
        "transferability",
        "trigger_clarity",
        "evidence_visibility",
        "compression",
        "score"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "needs_evidence",
        "reviewed",
        "unsupported_type",
        "incomplete_input"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    },
    "stop_rule": {
      "type": "string",
      "minLength": 1
    },
    "review_scope": {
      "type": "string",
      "minLength": 1
    },
    "method_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "content_eligible": {
      "type": "boolean"
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard",
        "unknown"
      ]
    },
    "answer_verification": {
      "type": "object",
      "properties": {
        "retained_candidates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "eliminated_candidates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "unresolved_candidates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "candidate_coverage_complete": {
          "type": "boolean"
        },
        "unique_supported_candidate": {
          "type": "boolean"
        },
        "closed": {
          "type": "boolean"
        }
      },
      "required": [
        "retained_candidates",
        "eliminated_candidates",
        "unresolved_candidates",
        "candidate_coverage_complete",
        "unique_supported_candidate",
        "closed"
      ],
      "additionalProperties": false
    },
    "grammar_navigation": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "hint_branch": {
              "enum": [
                "unknown",
                "with_hint",
                "without_hint"
              ]
            },
            "status": {
              "enum": [
                "needs_hint_confirmation",
                "needs_function_confirmation",
                "navigation_planned"
              ]
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "minItems": 0
            },
            "next_node": {
              "type": "string",
              "minLength": 1
            },
            "review_basis": {
              "enum": [
                "reviewed_trigger_routing_only"
              ]
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "hint_branch",
            "status",
            "paths",
            "next_node",
            "review_basis",
            "limitations"
          ],
          "additionalProperties": false
        }
      ]
    },
    "writing_feedback": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "review": {
              "type": "object",
              "properties": {
                "schema_version": {
                  "enum": [
                    "1.0.0"
                  ]
                },
                "question_type": {
                  "enum": [
                    "应用文",
                    "读后续写"
                  ]
                },
                "kind": {
                  "enum": [
                    "guidance",
                    "correction"
                  ]
                },
                "reviewer": {
                  "type": "string",
                  "minLength": 1
                },
                "review_status": {
                  "enum": [
                    "reviewed",
                    "unreviewed"
                  ]
                },
                "source_section_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "student_text_complete": {
                  "type": "boolean"
                },
                "student_text_excludes_given_starters": {
                  "type": "boolean"
                },
                "sections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "enum": [
                          "overall",
                          "diagnostics",
                          "anchors",
                          "emotion",
                          "outline",
                          "revised_text",
                          "practice",
                          "materials"
                        ]
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "field": {
                              "type": "string",
                              "minLength": 1
                            },
                            "start": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "end": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "quote": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "field",
                            "start",
                            "end",
                            "quote"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 1
                      }
                    },
                    "required": [
                      "key",
                      "text",
                      "evidence"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0
                },
                "corrections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "original": {
                        "type": "object",
                        "properties": {
                          "field": {
                            "type": "string",
                            "minLength": 1
                          },
                          "start": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "end": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "quote": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "field",
                          "start",
                          "end",
                          "quote"
                        ],
                        "additionalProperties": false
                      },
                      "replacement": {
                        "type": "string",
                        "minLength": 1
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "enum": [
                          "error",
                          "optional"
                        ]
                      }
                    },
                    "required": [
                      "original",
                      "replacement",
                      "reason",
                      "kind"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0
                },
                "reviewed_student_spans": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "minLength": 1
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "field",
                      "start",
                      "end",
                      "quote"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0
                },
                "proposed_score": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "scale": {
                          "enum": [
                            15,
                            25
                          ]
                        },
                        "lower": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 25
                        },
                        "upper": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 25
                        },
                        "band": {
                          "type": "string",
                          "minLength": 1
                        },
                        "rationale": {
                          "type": "string",
                          "minLength": 1
                        },
                        "evidence": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "field": {
                                "type": "string",
                                "minLength": 1
                              },
                              "start": {
                                "type": "integer",
                                "minimum": 0
                              },
                              "end": {
                                "type": "integer",
                                "minimum": 1
                              },
                              "quote": {
                                "type": "string",
                                "minLength": 1
                              }
                            },
                            "required": [
                              "field",
                              "start",
                              "end",
                              "quote"
                            ],
                            "additionalProperties": false
                          },
                          "minItems": 1
                        },
                        "source_section_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "handwriting_applied": {
                          "type": "boolean"
                        },
                        "original_handwriting_reference": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "scale",
                        "lower",
                        "upper",
                        "band",
                        "rationale",
                        "evidence",
                        "source_section_id",
                        "handwriting_applied",
                        "original_handwriting_reference"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "schema_version",
                "question_type",
                "kind",
                "reviewer",
                "review_status",
                "source_section_ids",
                "student_text_complete",
                "student_text_excludes_given_starters",
                "sections",
                "corrections",
                "reviewed_student_spans",
                "proposed_score"
              ],
              "additionalProperties": false
            },
            "scope": {
              "enum": [
                "guidance",
                "full_correction",
                "partial_feedback",
                "unreviewed"
              ]
            },
            "score_status": {
              "enum": [
                "external_proposal_not_certified",
                "withheld",
                "not_requested"
              ]
            },
            "source_document": {
              "type": "string",
              "minLength": 1
            },
            "section_order": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "evidence_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "review",
            "scope",
            "score_status",
            "source_document",
            "section_order",
            "evidence_ids",
            "limitations"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "question_id",
    "question_type",
    "task_type",
    "method_matches",
    "method_chain",
    "trigger_evidence",
    "evidence_graph",
    "candidate_analysis",
    "answer",
    "answer_confidence",
    "student_symptoms",
    "demonstration",
    "status",
    "limitations",
    "next_action",
    "stop_rule",
    "review_scope",
    "method_versions",
    "content_eligible",
    "difficulty",
    "answer_verification",
    "grammar_navigation",
    "writing_feedback"
  ],
  "additionalProperties": false
}

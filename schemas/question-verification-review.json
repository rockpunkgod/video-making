{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://answer.local/schemas/question-verification-review.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "material_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "enum": [
        "reviewed",
        "unreviewed"
      ]
    },
    "source_section_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "input_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "concrete_action": {
      "type": "string",
      "minLength": 1
    },
    "stop_rule_check": {
      "type": "string",
      "minLength": 1
    },
    "stop_applied": {
      "type": "boolean"
    },
    "candidate_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "enum": [
              "retain",
              "eliminate",
              "undetermined"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "field",
                "start",
                "end",
                "quote"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "decision_rule_check": {
            "type": "string",
            "minLength": 1
          },
          "backfill_check": {
            "type": "string",
            "minLength": 1
          },
          "backfill_verdict": {
            "enum": [
              "supports",
              "rejects",
              "unresolved"
            ]
          },
          "image_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "image_id": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "box": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minItems": 4,
                  "maxItems": 4
                },
                "observed": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "image_id",
                "sha256",
                "box",
                "observed"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "candidate",
          "claim",
          "effect",
          "evidence",
          "decision_rule_check",
          "backfill_check",
          "backfill_verdict"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "review_id",
    "question_id",
    "task_type",
    "source_commit",
    "material_sha256",
    "reviewer",
    "review_status",
    "source_section_ids",
    "input_artifact_ids",
    "concrete_action",
    "stop_rule_check",
    "stop_applied",
    "candidate_checks"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0.0"
          }
        }
      },
      "then": {
        "properties": {
          "candidate_checks": {
            "items": {
              "not": {
                "required": [
                  "image_evidence"
                ]
              }
            }
          }
        }
      }
    }
  ]
}

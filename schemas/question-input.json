{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://answer.local/schemas/question-input.json",
  "type": "object",
  "properties": {
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "question_type": {
      "enum": [
        "阅读理解",
        "七选五",
        "完形填空",
        "语法填空",
        "应用文",
        "读后续写",
        "未知"
      ]
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "passage": {
      "type": "string"
    },
    "stem": {
      "type": "string"
    },
    "options": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "student_symptoms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "field",
                "start",
                "end",
                "quote"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "reviewed": {
            "type": "boolean"
          }
        },
        "required": [
          "method_id",
          "evidence",
          "reviewed"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method_id": {
            "type": "string",
            "minLength": 1
          },
          "candidate": {
            "type": "string",
            "minLength": 1
          },
          "effect": {
            "enum": [
              "retain",
              "eliminate",
              "undetermined"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "field",
                "start",
                "end",
                "quote"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "decision_rule_check": {
            "type": "string",
            "minLength": 1
          },
          "stop_rule_check": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "review_status": {
            "enum": [
              "reviewed",
              "unreviewed"
            ]
          },
          "execution_role": {
            "enum": [
              "locator",
              "interpreter",
              "reducer",
              "decider",
              "verifier",
              "framework"
            ]
          }
        },
        "required": [
          "method_id",
          "candidate",
          "effect",
          "claim",
          "evidence",
          "decision_rule_check",
          "stop_rule_check",
          "verification",
          "reviewer",
          "review_status"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "given_word": {
      "type": [
        "string",
        "null"
      ]
    },
    "student_text": {
      "type": "string"
    },
    "continuation_starters": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "requested_chain": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard",
        "unknown"
      ]
    }
  },
  "required": [
    "question_id",
    "question_type",
    "stem"
  ],
  "additionalProperties": false
}

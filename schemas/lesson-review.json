{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://answer.local/schemas/lesson-review.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0.0",
        "1.1.0",
        "1.2.0"
      ]
    },
    "question_type": {
      "enum": [
        "阅读理解",
        "七选五",
        "完形填空",
        "语法填空"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "enum": [
        "reviewed",
        "unreviewed"
      ]
    },
    "source_section_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "segments": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "segment_id": {
                "type": "string",
                "minLength": 1
              },
              "function": {
                "enum": [
                  "action",
                  "evidence",
                  "comparison",
                  "stop"
                ]
              },
              "method_id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "field",
                    "start",
                    "end",
                    "quote"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "relation_indices": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 0
              }
            },
            "required": [
              "segment_id",
              "function",
              "method_id",
              "text",
              "evidence",
              "relation_indices"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "segment_id": {
                "type": "string",
                "minLength": 1
              },
              "segment_scope": {
                "const": "whole_question"
              },
              "function": {
                "const": "comparison"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "field",
                    "start",
                    "end",
                    "quote"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "terminal_review_id": {
                "type": "string",
                "minLength": 1
              },
              "candidate_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "image_evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "candidate": {
                      "type": "string",
                      "minLength": 1
                    },
                    "region_index": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "candidate",
                    "region_index"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "segment_id",
              "segment_scope",
              "function",
              "text",
              "evidence",
              "terminal_review_id",
              "candidate_ids"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "question_type",
    "reviewer",
    "review_status",
    "source_section_ids",
    "segments"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "enum": [
              "1.0.0",
              "1.1.0"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "segments": {
            "items": {
              "not": {
                "required": [
                  "image_evidence"
                ]
              }
            }
          }
        }
      }
    }
  ]
}

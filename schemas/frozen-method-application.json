{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only frozen method application projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "application_id", "semantic_binding_sha", "parent_asset_id", "parent_semantic_sha", "source", "source_sha", "payload", "semantic_review", "validation_kind", "generated_at", "public_render_ready", "content_sha", "envelope_sha"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "kind": {"const": "frozen_method_application"},
    "application_id": {"type": "string", "pattern": "^application:[a-f0-9]{64}$"},
    "semantic_binding_sha": {"$ref": "#/$defs/hash"},
    "parent_asset_id": {"type": "string", "minLength": 1},
    "parent_semantic_sha": {"$ref": "#/$defs/hash"},
    "source": {"type": "object"},
    "source_sha": {"$ref": "#/$defs/hash"},
    "payload": {
      "type": "object", "additionalProperties": false,
      "required": ["question", "method", "actual_action", "annotation", "review_refs"],
      "properties": {
        "question": {"type": "object"},
        "method": {
          "type": "object", "additionalProperties": false,
          "required": ["method_id", "version", "primary_role", "stop_rule"],
          "properties": {
            "method_id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "primary_role": {"enum": ["framework", "locator", "interpreter"]},
            "brand_name": {"type": "string"},
            "stop_rule": {"type": "string", "minLength": 1}
          }
        },
        "actual_action": {"type": "object"},
        "annotation": {"type": "object"},
        "review_refs": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["pointer", "artifact_id", "sha", "semantic_sha", "level"],
            "properties": {
              "pointer": {"type": "string", "pattern": "^/reviews/[0-9]+$"},
              "artifact_id": {"type": "string", "minLength": 1},
              "sha": {"$ref": "#/$defs/hash"},
              "semantic_sha": {"$ref": "#/$defs/hash"},
              "level": {"enum": ["ai_reviewed", "human_reviewed", "human_certified"]}
            }
          }
        }
      }
    },
    "semantic_review": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "independent_human_certified"],
      "properties": {
        "level": {"enum": ["ai_reviewed", "human_reviewed", "human_certified"]},
        "independent_human_certified": {"type": "boolean"}
      }
    },
    "validation_kind": {"const": "deterministic_binding_lint_not_semantic_truth_certification"},
    "generated_at": {"type": "string", "minLength": 1},
    "public_render_ready": {"const": false},
    "content_sha": {"$ref": "#/$defs/hash"},
    "envelope_sha": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

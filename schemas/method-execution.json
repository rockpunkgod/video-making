{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://answer.local/schemas/method-execution.json",
  "type": "object",
  "properties": {
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "method_id": {
      "type": "string",
      "minLength": 1
    },
    "method_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "role": {
      "enum": [
        "locator",
        "interpreter",
        "reducer",
        "decider",
        "verifier",
        "framework"
      ]
    },
    "input_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "concrete_action": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "field",
          "start",
          "end",
          "quote"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "decision_rule_check": {
      "type": "string",
      "minLength": 1
    },
    "stop_rule_check": {
      "type": "string",
      "minLength": 1
    },
    "stop_applied": {
      "type": "boolean"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "review_status": {
      "enum": [
        "reviewed",
        "unreviewed"
      ]
    },
    "output": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "located_evidence"
                  ]
                },
                "spans": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "minLength": 1
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "field",
                      "start",
                      "end",
                      "quote"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "kind",
                "spans"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "interpretation"
                  ]
                },
                "parts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "field": {
                              "type": "string",
                              "minLength": 1
                            },
                            "start": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "end": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "quote": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "field",
                            "start",
                            "end",
                            "quote"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 1
                      }
                    },
                    "required": [
                      "name",
                      "value",
                      "evidence"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "kind",
                "parts"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "candidate_partition"
                  ]
                },
                "axis": {
                  "type": "string",
                  "minLength": 1
                },
                "groups": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "candidates": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 1
                      }
                    },
                    "required": [
                      "label",
                      "candidates"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "kind",
                "axis",
                "groups"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "text_groups"
                  ]
                },
                "groups": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "spans": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "field": {
                              "type": "string",
                              "minLength": 1
                            },
                            "start": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "end": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "quote": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "field",
                            "start",
                            "end",
                            "quote"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 1
                      }
                    },
                    "required": [
                      "label",
                      "spans"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "kind",
                "groups"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "route_selection"
                  ]
                },
                "node_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              },
              "required": [
                "kind",
                "node_ids"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "framework_card"
                  ]
                },
                "fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "field": {
                              "type": "string",
                              "minLength": 1
                            },
                            "start": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "end": {
                              "type": "integer",
                              "minimum": 1
                            },
                            "quote": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "required": [
                            "field",
                            "start",
                            "end",
                            "quote"
                          ],
                          "additionalProperties": false
                        },
                        "minItems": 1
                      }
                    },
                    "required": [
                      "name",
                      "value",
                      "evidence"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "kind",
                "fields"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "candidate_decision"
                  ]
                },
                "candidate": {
                  "type": "string",
                  "minLength": 1
                },
                "effect": {
                  "enum": [
                    "retain",
                    "eliminate",
                    "undetermined"
                  ]
                },
                "relation_index": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "kind",
                "candidate",
                "effect",
                "relation_index"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "verification_result"
                  ]
                },
                "candidate": {
                  "type": "string",
                  "minLength": 1
                },
                "target_execution_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "verdict": {
                  "enum": [
                    "supports",
                    "rejects",
                    "unresolved"
                  ]
                }
              },
              "required": [
                "kind",
                "candidate",
                "target_execution_ids",
                "verdict"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "verification_result"
                  ]
                },
                "scope": {
                  "enum": [
                    "candidate_relation_check"
                  ]
                },
                "candidate": {
                  "type": "string",
                  "minLength": 1
                },
                "claim": {
                  "type": "string",
                  "minLength": 1
                },
                "target_execution_ids": {
                  "type": "array",
                  "maxItems": 0
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "minLength": 1
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "field",
                      "start",
                      "end",
                      "quote"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                },
                "relation_check": {
                  "type": "string",
                  "minLength": 1
                },
                "backfill_check": {
                  "type": "string",
                  "minLength": 1
                },
                "verdict": {
                  "enum": [
                    "supports",
                    "rejects",
                    "unresolved"
                  ]
                }
              },
              "required": [
                "kind",
                "scope",
                "candidate",
                "claim",
                "target_execution_ids",
                "evidence",
                "relation_check",
                "backfill_check",
                "verdict"
              ],
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  },
  "required": [
    "execution_id",
    "method_id",
    "method_version",
    "role",
    "input_artifact_ids",
    "concrete_action",
    "evidence",
    "decision_rule_check",
    "stop_rule_check",
    "stop_applied",
    "reviewer",
    "review_status",
    "output"
  ],
  "additionalProperties": false
}

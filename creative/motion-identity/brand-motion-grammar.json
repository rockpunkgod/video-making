    {"id": "focus_breathing", "memory_phrase": "焦点呼吸", "constraints": {"target_scale_percent": [100, 103], "background_weight_percent": [80, 88]}, "allowed_effects": ["scale", "opacity", "spacing", "local_blur"]},

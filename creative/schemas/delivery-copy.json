{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "version": {
      "const": "0.1.0"
    },
    "delivery_id": {
      "type": "string"
    },
    "package_id": {
      "type": "string"
    },
    "package_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "teaching_semantic_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider": {
      "const": "agent_authored_internal"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "unit_id": {
            "type": "string"
          },
          "scene_id": {
            "type": "string"
          },
          "source_claim_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "asset_id": {
                  "type": "string"
                },
                "pointer": {
                  "type": "string"
                }
              },
              "required": [
                "asset_id",
                "pointer"
              ],
              "additionalProperties": false
            }
          },
          "action_artifact_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "asset_id": {
                  "type": "string"
                },
                "pointer": {
                  "type": "string"
                }
              },
              "required": [
                "asset_id",
                "pointer"
              ],
              "additionalProperties": false
            }
          },
          "review_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "asset_id": {
                  "type": "string"
                },
                "pointer": {
                  "type": "string"
                }
              },
              "required": [
                "asset_id",
                "pointer"
              ],
              "additionalProperties": false
            }
          },
          "method_id": {
            "type": "string"
          },
          "asset_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "intent": {
            "enum": [
              "hook",
              "evidence",
              "core",
              "regroup",
              "routing",
              "rewire",
              "boundary",
              "stop",
              "method",
              "cta"
            ]
          },
          "source_meaning": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "claim_id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "claim_id",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "spoken_copy": {
            "type": "string"
          },
          "on_screen_copy": {
            "type": "string"
          },
          "protected_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "prohibited_implications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tone": {
            "type": "string"
          },
          "pause_after": {
            "type": "number",
            "minimum": 0
          },
          "breath": {
            "type": "string"
          },
          "emphasis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visual_excerpts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "object",
                  "properties": {
                    "asset_id": {
                      "type": "string"
                    },
                    "pointer": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "asset_id",
                    "pointer"
                  ],
                  "additionalProperties": false
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "text": {
                  "type": "string"
                },
                "candidate": {
                  "type": "string"
                }
              },
              "required": [
                "ref",
                "start",
                "end",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "fidelity_review": {
            "type": [
              "object",
              "null"
            ]
          },
          "sentence_bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "source_claim_refs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "evidence_refs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "asset_id": {
                        "type": "string"
                      },
                      "pointer": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "asset_id",
                      "pointer"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "text",
                "source_claim_refs",
                "evidence_refs"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "unit_id",
          "scene_id",
          "source_claim_refs",
          "evidence_refs",
          "action_artifact_refs",
          "review_refs",
          "method_id",
          "asset_id",
          "role",
          "intent",
          "source_meaning",
          "spoken_copy",
          "on_screen_copy",
          "protected_terms",
          "prohibited_implications",
          "tone",
          "pause_after",
          "breath",
          "emphasis",
          "visual_excerpts",
          "fidelity_review",
          "sentence_bindings"
        ],
        "additionalProperties": false
      }
    },
    "delivery_copy_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "screen_copy_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "editorial_review_sha": {
      "type": "null"
    },
    "public_render_ready": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "version",
    "delivery_id",
    "package_id",
    "package_sha",
    "manifest_sha",
    "teaching_semantic_sha",
    "provider",
    "units",
    "delivery_copy_sha",
    "screen_copy_sha",
    "editorial_review_sha",
    "public_render_ready"
  ],
  "additionalProperties": false
}

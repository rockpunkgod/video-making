{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "policy": {
      "const": "free_showcase_v1"
    },
    "kind": {
      "enum": [
        "teaching_claim",
        "source_display",
        "editorial",
        "final_media"
      ]
    },
    "review_id": {
      "type": "string"
    },
    "reviewer": {
      "type": "string"
    },
    "reviewer_kind": {
      "enum": [
        "human",
        "AI",
        "ai_host"
      ]
    },
    "origin": {
      "enum": [
        "external_human",
        "agent_authored"
      ]
    },
    "reviewed_at": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "pass",
        "fail"
      ]
    },
    "bindings": {
      "type": "object",
      "properties": {
        "policy": {
          "const": "free_showcase_v1"
        },
        "version": {
          "const": "1.0.0"
        },
        "teaching_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "final_copy_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_display_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "picture_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "audio_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "final_media_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "upstream_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "production_receipt_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "content_profile": {
          "const": "FREE_SHOWCASE"
        }
      },
      "required": [
        "policy",
        "version",
        "teaching_sha",
        "scope_sha",
        "final_copy_sha",
        "source_display_sha",
        "picture_sha",
        "audio_sha",
        "final_media_sha",
        "upstream_sha",
        "production_receipt_sha",
        "content_profile"
      ],
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "pending",
          "pass",
          "fail"
        ]
      }
    },
    "evidence_notes": {
      "type": "string"
    },
    "content_profile": {
      "const": "FREE_SHOWCASE"
    }
  },
  "required": [
    "schema_version",
    "policy",
    "kind",
    "review_id",
    "reviewer",
    "reviewer_kind",
    "origin",
    "reviewed_at",
    "status",
    "bindings",
    "checks",
    "evidence_notes",
    "content_profile"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "episode_id",
    "platform",
    "cut_version",
    "episode_sha",
    "final_copy_sha",
    "native_timeline_sha",
    "final_media_sha",
    "rubric_version",
    "hypotheses",
    "prediction_status",
    "prediction_created_at",
    "publication_status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "episode_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "final_copy_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "native_timeline_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "final_media_sha": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "prediction_status": {
      "enum": [
        "PRE_PRODUCTION_HYPOTHESIS",
        "FROZEN_FINAL_CUT"
      ]
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "hypothesis_id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "affected_question": {
            "type": "string",
            "minLength": 1
          },
          "affected_beat": {
            "type": "string",
            "minLength": 1
          },
          "expected_advantage": {
            "type": "string",
            "minLength": 1
          },
          "possible_failure": {
            "type": "string",
            "minLength": 1
          },
          "evidence_to_collect": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "hypothesis_id",
          "claim",
          "affected_question",
          "affected_beat",
          "expected_advantage",
          "possible_failure",
          "evidence_to_collect"
        ],
        "additionalProperties": false
      }
    }
  }
}
